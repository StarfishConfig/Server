<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\common.props" />

	<PropertyGroup>
		<NoWarn>CS2002</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Euonia.Bus" />
		<PackageReference Include="Euonia.Business" />
		<PackageReference Include="Euonia.Domain" />
		<PackageReference Include="Euonia.Repository " />
		<PackageReference Include="Euonia.Threading.Redis" />
		<PackageReference Include="IdentityModel" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Starfish.Domain\Starfish.Domain.csproj" />
		<ProjectReference Include="..\Starfish.Transit\Starfish.Transit.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="$(RootNamespace).Properties" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
