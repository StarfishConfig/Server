<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\common.props" />

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
        <NoWarn>CS2002</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Euonia.Bus" />
		<PackageReference Include="Euonia.Business" />
		<PackageReference Include="Euonia.Domain" />
		<PackageReference Include="Euonia.Repository " />
		<PackageReference Include="IdentityModel" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Starfish.Toolkit\Starfish.Toolkit.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
    
    <ItemGroup>
        <Using Include="Nerosoft.Starfish.Domain.Properties" />
    </ItemGroup>

</Project>
